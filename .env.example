# Local data root. Keep this outside Git, preferably on a high-capacity SSD.
CMU_DATA_ROOT=/path/on/ssd/cmu-data

# Used by the isolated OVITO/Tachyon rendering worker.
MATERIALS_OVITO_PYTHON=/path/to/ovito-enabled/python

# Convenience defaults for local serving.
CMU_HOST=127.0.0.1
CMU_PORT=8000

# Materiae catalogue API tokens (User -> Profile -> Generate on the site).
# Access token is valid 7 days, refresh token 1 year; the fetcher auto-refreshes.
MATERIAE_API_ACCESS_TOKEN=
MATERIAE_API_REFRESH_TOKEN=

# Materials Project API key (next-gen.materialsproject.org -> Dashboard -> API).
# Read at runtime and sent only as the X-API-KEY header; never write it into a
# receipt, manifest or logged URL.
MP_API_KEY=

# Hugging Face token for scripts/fetch_index.py. Optional: an ambient
# `hf auth login` or HF_TOKEN works too. AI4QC/MateriaViva is private, so some
# token is required either way.
HF_TOKEN=

# Interpreter the property-pipeline stages run under (scripts/properties/*).
# Defaults to whichever interpreter launched the driver, so this is only needed
# when the stages require a different environment than the caller.
MV_PYTHON=

# Where the pipeline chain scripts write verification reports and summaries.
# Defaults to data/props_work/_out inside the repository.
MV_OUT=

# Directory holding the base merge's local-candidate hash TSVs
# (local_hashes_train.tsv / local_hashes_val.tsv). Not produced by this
# repository. Defaults to data/raw/lemat_merge_work.
MV_LEMAT_MERGE_WORK=

# Carolina Materials Database LMDB from the Zenodo bulk release. Defaults to
# data/raw/legacy-material-data/carolina_matdb_structs.lmdb, the legacy-data
# symlink described in docs/storage-layout.md.
MV_CAROLINA_LMDB=

# Where the detached Atomly harvester writes its logs. Defaults to
# data/raw/acquired/atomly/_logs inside the repository.
MV_ATOMLY_LOG_DIR=

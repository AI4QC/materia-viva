{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crystal-material-universe.local/schemas/crystal-record-v1.schema.json",
  "title": "Crystal Record v1",
  "description": "Logical schema shared by every CMU source CSV split.",
  "type": "object",
  "additionalProperties": false,
  "required": ["index", "material_id", "cif", "pbes_gap"],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0,
      "description": "Non-negative source-local record identifier."
    },
    "material_id": {
      "type": "string",
      "minLength": 1,
      "description": "Composition identifier used to derive the canonical formula."
    },
    "cif": {
      "type": "string",
      "minLength": 1,
      "description": "UTF-8 crystallographic information file payload."
    },
    "pbes_gap": {
      "type": ["number", "null"],
      "description": "PBEsol band gap in eV when available."
    }
  }
}
